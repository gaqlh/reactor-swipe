{
  "manifest_version": 2,
  "name": "Reactor Swipe",
  "version": "0.1.0",
  "description": "JoyReactor como un feed: scroll infinito, miniaturas, hashtags favoritos, aleatorio a tu medida, me gusta / no me gusta y avisos de posts nuevos.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "https://*.joyreactor.com/*"
  ],
  "background": {
    "scripts": [
      "js/shared.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Reactor Swipe",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://joyreactor.com/*",
        "https://www.joyreactor.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "reactor-swipe@personal",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
